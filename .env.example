# ============================================================
# SIP-Postgrado UNEFA — Variables de Entorno de Ejemplo
# ============================================================
# Copia este archivo como .env y edita los valores para tu entorno.
# ============================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=unefa_postgrados
DB_USER=postgres
DB_PASSWORD=postgres

# Entorno: development | production
APP_ENV=development
APP_DEBUG=true

# URL base
BASE_URL=http://localhost/SIP

# Zona horaria
APP_TIMEZONE=America/Caracas
